# Free key from https://uniblock.dev — only needed for `npm run aggregated`.
# `npm run by-hand`, `npm run conflux` and `npm run verify` need nothing.
UNIBLOCK_KEY=

# Optional: override the API base if the endpoint differs from the default.
# UNIBLOCK_URL=https://api.uniblock.dev/v1

# Optional: read a different wallet.
# WALLET=0x...
