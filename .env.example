# Your Uniblock API key. Only `node src/aggregated.js` needs it —
# by-hand.js, add-conflux.js and verify-tokens.js all run without one.
#
# Copy this file to .env (which is gitignored) and paste your key below.
UNIBLOCK_KEY=

# Optional: override the API base. The default is correct as of the docs at
# https://docs.uniblock.dev/api-reference/token/get-address-token-balances
# UNIBLOCK_URL=https://api.uniblock.dev/uni/v1

# Optional: read a different wallet.
# WALLET=0x...
